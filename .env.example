# ==========================================================
# GATOVEL STORAGE - EXAMPLE ENVIRONMENT CONFIGURATION
# ==========================================================

# ----------------------------------------------------------
# Storage
# ----------------------------------------------------------

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage

# ----------------------------------------------------------
# Amazon S3
# ----------------------------------------------------------

AWS_REGION=us-east-1
AWS_BUCKET=

# AWS credentials
# Prefer IAM Roles or the AWS SDK credential provider chain.
# Set these variables only when necessary.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional S3 object prefix
STORAGE_S3_PREFIX=application

# ----------------------------------------------------------
# LocalStack (local development only)
# ----------------------------------------------------------

# Example endpoint:
# http://host.docker.internal:4566

STORAGE_S3_ENDPOINT=

# Set to true when using path-style S3 endpoints.
STORAGE_S3_PATH_STYLE=false
